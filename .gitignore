# secrets
.env
**/.env
*cookies*.txt
backend/app/data/facebook_cookies.txt
scraper/facebook_cookies.txt
scraper/session.json
# instagram_session.json holds a live authenticated session - as sensitive as
# the password itself. The *_cache.json files are just scraped posts, but
# they're machine-local state, not source.
backend/app/data/instagram_session.json
backend/app/data/instagram_cache.json
backend/app/data/facebook_cache.json
backend/app/data/tiktok_cache.json
# x_cache.json holds scraped public posts INCLUDING the account names of
# private citizens. Publishing that to a public repo would be exactly the
# profiling/retention the ethics framework prohibits - see GOBERNANZA_ETICA.md.
backend/app/data/x_cache.json
scraper/ig_session.json
scraper/instagram_cache.json

# python
__pycache__/
*.pyc
.venv/
venv/

# node / svelte
node_modules/
dist/
.svelte-kit/

# logs / scratch
*.log
backend_log.txt
server.log
