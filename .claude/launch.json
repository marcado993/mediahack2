{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import http.server,os; os.chdir('frontend'); port=int(os.environ.get('PORT',5173)); http.server.ThreadingHTTPServer(('0.0.0.0',port),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "backend", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 5174
    }
  ]
}
