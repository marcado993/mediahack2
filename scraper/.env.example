# Copy this file to .env and fill in real values. Never commit .env.
IG_USERNAME=
IG_PASSWORD=
# Where the scraper writes its session file so it doesn't re-login every run.
IG_SESSION_PATH=./session.json

# Cookies for fb_scraper.py (kevinzg/facebook-scraper). Facebook requires a
# logged-in session even for public pages now - anonymous requests hit a
# login wall. Either:
#   - a path to a cookies.txt file exported from your logged-in browser
#     (Netscape format, e.g. via the "Get cookies.txt LOCALLY" extension), or
#   - the literal value "from_browser" (needs `pip install browser_cookie3`
#     and being logged into Facebook in a browser on this machine)
FB_COOKIES=
